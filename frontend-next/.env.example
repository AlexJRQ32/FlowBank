NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_key_here
# Server-only, NOT prefixed NEXT_PUBLIC (bypasses RLS; route handler /api/tipo-cambio cache write)
SUPABASE_SERVICE_ROLE_KEY=

# Public site origin. Local dev as below; in production set to the Vercel deployment URL (e.g. https://flowbank.vercel.app).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
